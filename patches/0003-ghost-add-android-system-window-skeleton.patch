+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+#pragma once
+
+#include "GHOST_SystemHeadless.hh"
+
+#include <android/native_window.h>
+
+class GHOST_SystemAndroid : public GHOST_SystemHeadless {
+ public:
+  explicit GHOST_SystemAndroid(bool /*background*/) : GHOST_SystemHeadless() {}
+  ~GHOST_SystemAndroid() override = default;
+
+  GHOST_TSuccess init() override;
+
+  GHOST_TSuccess setNativeWindow(ANativeWindow *window);
+  void clearNativeWindow();
+
+  GHOST_IWindow *createWindow(const char *title,
+                              int32_t left,
+                              int32_t top,
+                              uint32_t width,
+                              uint32_t height,
+                              GHOST_TWindowState state,
+                              GHOST_GPUSettings gpu_settings,
+                              const bool exclusive,
+                              const bool is_dialog,
+                              const GHOST_IWindow *parent_window) override;
+
+  void getMainDisplayDimensions(uint32_t &width, uint32_t &height) const override;
+  void getAllDisplayDimensions(uint32_t &width, uint32_t &height) const override;
+
+ private:
+  ANativeWindow *native_window_ = nullptr;
+};
